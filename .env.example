# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scanorder_db

# Contraseña de root de MySQL (usar la misma que DB_PASSWORD si DB_USER=root)
MYSQL_ROOT_PASSWORD=

# ─── JWT / Seguridad ──────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ScanOrder
DEBUG=false

# ─── URL del menú (QR) ────────────────────────────────────────────────────────
# Reemplazá TU_IP_LOCAL con la IP de tu computadora en la red local
# Ejemplo: http://192.168.1.100/frontend/cliente/menu.html
MENU_URL=http://TU_IP_LOCAL/frontend/cliente/menu.html

# No usar detección automática de IP dentro de Docker
AUTO_LAN_IP=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. La MENU_URL se agrega automáticamente.
# Si el admin se abre desde otra máquina, agregar su origen aquí también.
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
CORS_ORIGIN_REGEX=

# ─── Usuario admin inicial ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@scanorder.local
ADMIN_NOMBRE=Administrador
