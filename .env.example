# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scanorder_db

# Contraseña de root de MySQL (usar la misma que DB_PASSWORD si DB_USER=root)
MYSQL_ROOT_PASSWORD=

# ─── JWT / Seguridad ──────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ScanOrder
DEBUG=false

# ─── URL del menú (QR) ────────────────────────────────────────────────────────
# Reemplazá TU_IP_LOCAL con la IP de tu computadora en la red local
# Ejemplo: http://192.168.1.100/frontend/cliente/menu.html
MENU_URL=http://TU_IP_LOCAL/frontend/cliente/menu.html

# No usar detección automática de IP dentro de Docker
AUTO_LAN_IP=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. La MENU_URL se agrega automáticamente.
# Si el admin se abre desde otra máquina, agregar su origen aquí también.
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
CORS_ORIGIN_REGEX=

# ─── Notificaciones WhatsApp (Twilio) ────────────────────────────────────────
# Opcional. Si no se configuran, el sistema sigue funcionando sin notificaciones.
# Obtener en: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número origen de Twilio en formato WhatsApp (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Número del restaurante que recibe los avisos
TWILIO_WHATSAPP_TO=whatsapp:+XXXXXXXXXXX

# ─── Email (relay SMTP transaccional) ────────────────────────────────────────
# Opcional. Si no se configuran, los emails se descartan silenciosamente.
# No usar un Gmail personal: Google bloquea en silencio el envío automatizado
# hacia destinatarios sin historial previo con el remitente (sin rebote, sin
# caer en spam). Usar un proveedor transaccional (ej. Brevo, free tier):
# https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxxxxxxxxxxxxxxxxx@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx
# Dirección remitente visible para el destinatario (debe estar verificada en el proveedor)
EMAIL_FROM=noreply@scanorder.local

# URL base del frontend (para links en emails de bienvenida y reset de contraseña)
FRONTEND_URL=http://localhost:5500

# ─── Panel de cocina ─────────────────────────────────────────────────────────
# Token fijo por dispositivo para autenticar el panel de cocina (sin login de usuario).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# El mismo valor debe setearse en window.COCINA_DEVICE_TOKEN en pedidos.html.
COCINA_DEVICE_TOKEN=reemplazar_con_token_seguro_generado

# ─── Usuario admin inicial ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@scanorder.local
ADMIN_NOMBRE=Administrador
